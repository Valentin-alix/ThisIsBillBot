<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>Xpl0itR</Authors>
    <BaseOutputPath>..\..\bin\$(MSBuildProjectName)</BaseOutputPath>
    <Copyright>Copyright © 2024-2026 Xpl0itR</Copyright>
    <Description>Supporting library for LibProtodec</Description>
    <IncludeSymbols>true</IncludeSymbols>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <LangVersion>Latest</LangVersion>
    <NoWarn>NU5104</NoWarn>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Samboy063.Cpp2IL.Plugin.Mfuscator" Version="2022.1.0-development.1489" />
    <PackageReference Include="Samboy063.Cpp2IL.Plugin.StrippedCodeRegSupport" Version="2022.1.0-development.1489" />
    <PackageReference Include="Samboy063.LibCpp2IL" Version="2022.1.0-development.1489" />
    <PackageReference Include="SingleFileExtractor.Core" Version="2.3.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.5" />
    <PackageReference Include="Xpl0itR.SystemEx" Version="1.3.0" />
  </ItemGroup>

</Project>